{
  "id": "fr.ferhatsn.Tunnelbird",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "tunnelbird",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=network",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=~/.cert/nm-openvpn:create",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/tunnelbird/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": [
    "/share/doc"
  ],
  "modules": [
    {
      "name": "tunnelbird",
      "buildsystem": "simple",
      "build-commands": [
        "make PREFIX=/app",
        "make install PREFIX=/app"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            "target",
            "build-flatpak",
            ".flatpak-builder",
            ".git"
          ]
        },
        "cargo-sources.json"
      ]
    }
  ]
}
